
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User History</title>
  <link rel="stylesheet" href="/css/main.css" />

</head>

<body tabindex="-1">
    
    <%- include('partials/navbar', {page: 'userHistory'}) %>

    <div class="container mx-auto p-4 space-y-4">
        <div class="hero bg-base-200 rounded-lg p-6">
            <div class="hero-content text-center ">
                <div class="max-w-md">
                    <h1 class="text-5xl font-bold"><%= user.userName %></h1>
                    <p class="py-6">User History: <%= user.email %></p>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto overflow-y-hidden">
            <table class="table table-zebra">
                <thead>
                    <tr> 
                        <th>Login Date/Time</th>
                        <th>Client Information</th>
                    </tr>
                </thead>
                <tbody>
                    <% user.loginHistory.forEach(history=> { %>
                        <tr> 
                            <th><%= new Date(history.dateTime).toString() %></th>
                            <th><%= history.userAgent %></th>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>